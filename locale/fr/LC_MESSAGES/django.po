msgid "Its %(counter)s evidence file is deleted with it."
msgid_plural "Its %(counter)s evidence files are deleted with it."
msgstr[0] "Son %(counter)s fichier de preuve est supprimé avec elle."
msgstr[1] "Ses %(counter)s fichiers de preuve sont supprimés avec elle."

msgid ""
"This run was submitted : its result, its observations and its evidence are "
